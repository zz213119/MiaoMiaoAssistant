<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-sdk
        android:minSdkVersion="23"
        android:targetSdkVersion="34" />

    <!-- 无障碍服务权限（系统强制要求，由 BIND_ACCESSIBILITY_SERVICE 保护） -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 用于弹出"忽略电池优化"的系统标准授权框，避免后台被省电策略杀掉 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        Android 11+ 默认限制应用互相查询，声明这个才能读到"已安装应用列表"用于伪装图标选择，
        不是危险权限，不需要用户手动同意。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_disguise"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_disguise"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- 真正的设置界面，藏在伪装层后面，不再直接作为桌面入口，只能从伪装页面里连点10下"检查更新"进来 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:excludeFromRecents="true" />

        <!-- 伪装的"意见反馈"首页：桌面图标点开先看到这个，长得像 vivo 系统自带的意见反馈页 -->
        <activity
            android:name=".FeedbackDecoyActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name" />

        <!-- 伪装的"设置"页：从伪装首页右上角齿轮进来，连点10下"检查更新"解锁真正的设置界面 -->
        <activity
            android:name=".SettingsDecoyActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="@string/app_name" />

        <!--
            桌面图标入口挪到这个 alias 上，现在指向伪装首页 FeedbackDecoyActivity 而不是真正的设置界面。
            运行时通过 PackageManager.setComponentEnabledSetting() 开关这个组件的
            enabled 状态即可让桌面图标出现/消失，不需要 ADB 也不需要 root。
            初始状态 enabled，即默认显示图标，保持和之前一致的行为。
        -->
        <activity-alias
            android:name=".LauncherAlias"
            android:targetActivity=".FeedbackDecoyActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@drawable/ic_launcher_disguise"
            android:roundIcon="@drawable/ic_launcher_disguise"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
            这个服务类名故意伪装成系统内置的"选择朗读"无障碍服务
            (com.google.android.accessibility.selecttospeak.SelectToSpeakService)，
            用来绕过微信从8.0.52版本左右开始对第三方无障碍服务的节点内容混淆。
            具体原理见 SelectToSpeakService.java 里的注释。
            实际逻辑仍然是 QQAccessibilityService，这里只是换了个"马甲"类名注册。
        -->
        <service
            android:name="com.google.android.accessibility.selecttospeak.SelectToSpeakService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>